# Database
POSTGRES_DB=leadflow
POSTGRES_USER=leadflow
POSTGRES_PASSWORD=change_me_locally
DATABASE_URL=jdbc:postgresql://postgres:5432/leadflow
POSTGRES_HOST_PORT=5432

# Backend
SPRING_PROFILES_ACTIVE=dev
APP_JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
N8N_WEBHOOK_SECRET=replace_with_a_long_random_secret_at_least_32_chars
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8080
BACKEND_HOST_PORT=8080
DEMO_MODE=false
QUALIFICATION_PROMPT_VERSION=v1
AI_HTTP_TIMEOUT_MS=20000

# n8n endpoints called by Spring Boot
N8N_WEBHOOK_QUALIFY_URL=http://n8n:5678/webhook/leadflow/qualify
N8N_WEBHOOK_EMAIL_DRAFT_URL=http://n8n:5678/webhook/leadflow/email-draft
N8N_WEBHOOK_EMAIL_SEND_URL=http://n8n:5678/webhook/leadflow/email-send
BACKEND_CALLBACK_URL=http://backend:8080/api/v1/automation/callbacks

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# n8n
N8N_ENCRYPTION_KEY=replace_with_a_long_random_key_at_least_32_chars
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_HOST_PORT=5678

# Groq / LLM adapter (server-side only, never exposed to the browser)
# Current production model recommended by Groq in 2026. Verify at
# https://console.groq.com/docs/models before changing.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Email (simulation by default: no real delivery)
EMAIL_PROVIDER=console
